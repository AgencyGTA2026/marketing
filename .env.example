# Calendly Scheduling Configuration
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/bayline-digital/intro

# Slack Webhook Integrations (Lead Intake Form)
# Location-page leads include City, Service, and full UTM/gclid attribution.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/LEADS/WEBHOOK

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional Google Ads conversion tag fired on /thank-you (e.g. AW-XXXXXXXXX/abcDEF...)
# Leave unset until the Ads conversion action is created.
NEXT_PUBLIC_ADS_CONVERSION_ID=

# AutoBlogWriter Blog Integration
AUTOBLOGWRITER_API_KEY=ba_pk_your_api_key_here
AUTOBLOGWRITER_WORKSPACE_SLUG=your-workspace-slug
SITE_URL=https://www.baylinedigital.com
AUTOBLOGWRITER_REVALIDATE_SECRET=your_webhook_secret
# Bayline Digital Social Studio (owner-only; localhost and explicitly allowed production hosts)
# Supabase Connect → Shared Pooler → Transaction mode (port 6543).
# Keep sslmode=require and replace the password placeholder.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase direct connection (or session pooler if IPv6 is unavailable), used by Drizzle migrations.
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=

BETTER_AUTH_SECRET=
# Use http://localhost:3000 locally and https://www.baylinedigital.com in production.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact hostnames. SITE_URL and BETTER_AUTH_URL hosts are also allowed automatically.
STUDIO_ALLOWED_HOSTS=www.baylinedigital.com,baylinedigital.com
STUDIO_OWNER_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL="Bayline Digital Studio <studio@yourdomain.com>"

META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
