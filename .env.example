# Calendly Scheduling Configuration
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/bayline-digital/intro

# Slack Webhook Integrations (Lead Intake Form)
# Location-page leads include City, Service, and full UTM/gclid attribution.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/LEADS/WEBHOOK

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional Google Ads conversion tag fired on /thank-you (e.g. AW-XXXXXXXXX/abcDEF...)
# Leave unset until the Ads conversion action is created.
NEXT_PUBLIC_ADS_CONVERSION_ID=

# AutoBlogWriter Blog Integration
AUTOBLOGWRITER_API_KEY=ba_pk_your_api_key_here
AUTOBLOGWRITER_WORKSPACE_SLUG=your-workspace-slug
SITE_URL=https://www.baylinedigital.com
AUTOBLOGWRITER_REVALIDATE_SECRET=your_webhook_secret
